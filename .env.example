# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY INTEGRATION (PRODUCTION / SANDBOX)
# -----------------------------------------------------------------------------
# Server-side environment variables for payment order creation and cryptographic HMAC SHA-256 signature verification
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Razorpay Webhook Secret (Leave blank if you have not configured a webhook in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# ADMIN SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Master password for Indima Spice Co. Admin Portal (Can be changed in Admin Portal)
ADMIN_PASSWORD="indima@2026"

# Optional: Allowed CORS origin in production (e.g., https://indimaspice.com)
ALLOWED_ORIGIN=

# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK & FIRESTORE DATABASE
# -----------------------------------------------------------------------------
# Project ID for Firebase/GCP services (Defaults to project config if omitted)
FIREBASE_PROJECT_ID="gen-lang-client-0691323767"

# Optional: Dedicated Firestore Database ID (Defaults to (default))
FIRESTORE_DATABASE_ID="ai-studio-indimaspiceco-37defe71-2543-4b75-b4ea-7ea37ff1b9d7"

# Optional: Firebase Storage Bucket for persistent media uploads
FIREBASE_STORAGE_BUCKET="gen-lang-client-0691323767.firebasestorage.app"

# Optional: Firebase Service Account Credentials (JSON string or individual key + email)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
