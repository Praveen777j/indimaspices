# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY INTEGRATION (PRODUCTION / SANDBOX)
# -----------------------------------------------------------------------------
# Server-side environment variables for payment order creation and cryptographic HMAC SHA-256 signature verification
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Razorpay Webhook Secret (Leave blank if you have not configured a webhook in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# ADMIN SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Master password for Indima Spice Co. Admin Portal (Can be changed in Admin Portal)
ADMIN_PASSWORD="indima@2026"

# Optional: Allowed CORS origin in production (e.g., https://indimaspice.com)
ALLOWED_ORIGIN=

# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK & FIRESTORE DATABASE (PRODUCTION)
# -----------------------------------------------------------------------------
# Required on Render: Full service account JSON (raw string or base64 encoded)
FIREBASE_SERVICE_ACCOUNT=

# Optional: Overrides project ID (defaults to "indimaspicea" or project_id in FIREBASE_SERVICE_ACCOUNT)
FIREBASE_PROJECT_ID=indimaspicea

# Optional: Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=indimaspicea.firebasestorage.app

# Optional: Alternative separate client email / private key format
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# ONE-TIME FIRESTORE MIGRATION TRIGGER
# -----------------------------------------------------------------------------
# Set to 'true' ONLY for a single restart when migrating data/db.json into Cloud Firestore.
# When absent or 'false', migration does not run and the server runs normally.
RUN_FIRESTORE_MIGRATION=false

