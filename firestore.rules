rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRating(rating) {
      return rating is number && rating >= 1 && rating <= 5;
    }

    // Public catalog & content collections (read allowed for store visitors)
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Managed exclusively via server Firebase Admin SDK
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; // Managed exclusively via server Firebase Admin SDK
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false; // Managed exclusively via server Firebase Admin SDK
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false; // Managed exclusively via server Firebase Admin SDK
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if false; // Managed exclusively via server Firebase Admin SDK
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && 
        request.resource.data.rating is number &&
        isValidRating(request.resource.data.rating) &&
        request.resource.data.customer_name is string &&
        request.resource.data.customer_name.size() > 0 &&
        request.resource.data.customer_name.size() <= 100 &&
        request.resource.data.comment_en is string &&
        request.resource.data.comment_en.size() > 0 &&
        request.resource.data.comment_en.size() <= 1000;
      allow update, delete: if false; // Moderated via server Admin API
    }

    match /leads/{leadId} {
      allow read: if false; // Private lead data protected
      allow create: if isValidId(leadId) &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 10 &&
        request.resource.data.phone.size() <= 15;
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false; // Managed exclusively via server APIs to protect PII
    }

    match /customers/{customerId} {
      allow read, write: if false; // Managed exclusively via server APIs to protect PII
    }

    match /processed_webhook_events/{eventId} {
      allow read, write: if false; // Server internal idempotency tracking
    }

    match /settings/{settingId} {
      allow read, write: if false; // Managed & sanitized exclusively via server APIs
    }

    match /audit_logs/{logId} {
      allow read, write: if false; // Server internal audit trail
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

