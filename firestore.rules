rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // PUBLIC CATALOG & CONTENT (Read-only for storefront visitors)
    // All writes are strictly restricted to the server Firebase Admin SDK.
    // ========================================================================

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }

    // Order Notifications: Real-time alerts for incoming store & WhatsApp orders
    // Client dashboard snapshot listeners can read sanitized order alert events in real time.
    // Writes are strictly restricted to the server Firebase Admin SDK.
    match /order_notifications/{notificationId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews: Public visitors can ONLY read approved reviews.
    // Submission and moderation are routed strictly through server APIs with rate limiting.
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true;
      allow write: if false;
    }

    // ========================================================================
    // SENSITIVE & PRIVATE STORE DATA (DENY-ALL CLIENT ACCESS)
    // Protected against client-side direct access.
    // Managed exclusively via server Express APIs with authentication & validation.
    // ========================================================================

    // Orders: Real-time incoming order alerts for Admin Dashboard.
    // Client dashboard snapshot listeners can read orders in real time.
    // Writes are strictly restricted to the server Firebase Admin SDK.
    match /orders/{orderId} {
      allow read: if true;
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read, write: if false;
    }

    match /processed_webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    // Default deny-all fallback for any unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
